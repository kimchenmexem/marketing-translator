{
  "name": "marketing-translator-backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "decision:harness": "ts-node-dev --transpile-only test/decision-layer-harness.ts",
    "test:quality-gate": "ts-node-dev --transpile-only src/test/quality-gate-tests.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema ../prisma/schema.prisma",
    "migrate:status": "prisma migrate status --schema ../prisma/schema.prisma",
    "promote:admin": "ts-node --transpile-only src/scripts/promote-admin.ts",
    "db:seed:sources": "ts-node --transpile-only src/scripts/seed-compliance-sources.ts",
    "seed:compliance-content": "ts-node --transpile-only src/scripts/seed-compliance-content.ts",
    "compliance:sync": "ts-node --transpile-only src/scripts/compliance-sync.ts",
    "db:seed:publishers": "ts-node --transpile-only src/scripts/seed-publisher-sources.ts",
    "publisher:sync": "ts-node --transpile-only src/scripts/publisher-sync.ts",
    "seed:eu-baseline": "ts-node --transpile-only src/scripts/seed-eu-baseline.ts",
    "seed:fca-baseline": "ts-node --transpile-only src/scripts/seed-fca-baseline.ts",
    "seed:national-obligations": "ts-node --transpile-only src/scripts/seed-national-obligations.ts",
    "seed:source-placeholders": "ts-node --transpile-only src/scripts/seed-source-placeholders.ts",
    "seed:cysec-overlay": "ts-node --transpile-only src/scripts/seed-cysec-overlay.ts",
    "recompile:bundles": "ts-node --transpile-only src/scripts/recompile-bundles.ts",
    "eval:compliance": "ts-node --transpile-only src/scripts/compliance-eval.ts",
    "seed:glossary": "ts-node --transpile-only src/scripts/seed-glossary.ts",
    "seed:homepage-translations": "ts-node --transpile-only src/scripts/seed-homepage-translations.ts",
    "seed:fr-trading-forbidden": "ts-node --transpile-only src/scripts/seed-fr-trading-forbidden.ts",
    "fix:fr-trading-glossary": "ts-node --transpile-only src/scripts/fix-fr-trading-glossary.ts",
    "seed:es-trading-forbidden": "ts-node --transpile-only src/scripts/seed-es-trading-forbidden.ts",
    "seed:nl-trading-forbidden": "ts-node --transpile-only src/scripts/seed-nl-trading-forbidden.ts",
    "test:compliance": "ts-node --transpile-only src/test/compliance-sot-tests.ts",
    "test:compliance-executor": "ts-node --transpile-only src/test/compliance-executor-tests.ts",
    "test:compliance-suppression": "ts-node --transpile-only src/test/compliance-suppression-tests.ts",
    "test:homepage-translations": "ts-node --transpile-only src/test/homepage-translations-tests.ts",
    "test:fr-trading-rules": "ts-node --transpile-only src/test/fr-trading-rules-tests.ts",
    "test:es-trading-rules": "ts-node --transpile-only src/test/es-trading-rules-tests.ts",
    "test:nl-trading-rules": "ts-node --transpile-only src/test/nl-trading-rules-tests.ts",
    "test:admin-auth": "ts-node --transpile-only src/test/admin-auth-tests.ts",
    "test:translation-failures": "ts-node --transpile-only src/test/translation-failure-tests.ts",
    "test:integration": "ts-node --transpile-only src/test/integration-tests.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.7",
    "@mexem/shared": "file:../packages/shared",
    "@prisma/client": "^5.0.0",
    "@types/node-cron": "^3.0.11",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "node-cron": "^4.2.1",
    "openai": "^4.0.0",
    "zod": "^3.23.2"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/node": "^20.14.5",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
