# ─────────────────────────────────────────────────────────────────────────────
# marketing-translator — frontend environment variables (Vite)
#
# Copy this file to frontend/.env and fill in the values.
# Vite only exposes variables prefixed with VITE_ to browser code.
# ─────────────────────────────────────────────────────────────────────────────


# ── Backend base URL ─────────────────────────────────────────────────────────
# PROD REQUIRED when frontend and backend are hosted at different origins
# (e.g. Vercel frontend → Render backend). Must be the full scheme + host of
# the deployed backend, with no trailing slash.
#
# Leave UNSET for local development — the Vite dev server proxies /api/* to
# http://localhost:4000 automatically (see frontend/vite.config.ts).
#
# Examples:
#   staging:  VITE_API_BASE_URL=https://api.staging.marketing-translator.example.com
#   prod:     VITE_API_BASE_URL=https://api.marketing-translator.example.com
#
# VITE_API_BASE_URL=


# ── Clerk (authentication) ────────────────────────────────────────────────────
# REQUIRED for frontend sign-in / sign-out and authenticated API calls.
# Get this from https://dashboard.clerk.com  →  your application  →  API keys.
# Must be the *publishable* key (starts with `pk_test_` or `pk_live_`).
# Must point at the same Clerk instance as CLERK_SECRET_KEY in backend/.env.
#
# Leave empty to disable auth in local dev — the app boots, but sign-in UI
# is hidden and /api/auth/me returns 503. All role-protected routes will 503.
#
VITE_CLERK_PUBLISHABLE_KEY=
