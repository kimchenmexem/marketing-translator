# ─────────────────────────────────────────────────────────────────────────────
# marketing-translator — backend environment variables
#
# Copy this file to backend/.env and fill in the values marked REQUIRED.
# Variables marked OPTIONAL have safe defaults for local development.
# Variables marked PROD REQUIRED must be set explicitly in production
# (the server will refuse to start without them when NODE_ENV=production).
#
# Generate strong secrets:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────


# ── Runtime ───────────────────────────────────────────────────────────────────
# OPTIONAL. Defaults: development. Set to "production" on deployed servers.
NODE_ENV="development"

# OPTIONAL. Defaults: 4000.
PORT="4000"


# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED (always). PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev example (Docker):
#   docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:dev@localhost:5432/marketing_translator"


# ── OpenAI ────────────────────────────────────────────────────────────────────
# REQUIRED (always). Every translation and compliance call needs this.
OPENAI_API_KEY="your-openai-api-key"

# OPTIONAL. Override the OpenAI API base URL.
# Only used in integration tests to redirect calls to a mock server.
# Leave unset in all other environments.
# OPENAI_BASE_URL=

# OPTIONAL. Number of automatic retries on transient OpenAI errors.
# Defaults to the OpenAI SDK default (2). Set to 0 to disable retries.
# OPENAI_MAX_RETRIES=2


# ── Security (deprecated) ────────────────────────────────────────────────────
# DEPRECATED. No live route consults X-Admin-Token anymore — authorization is
# now role-based (see Clerk + INITIAL_ADMIN_EMAILS below). Kept only so legacy
# tests and emergency tools still run. Safe to leave unset.
# If you do set it in prod, it must not be the placeholder value.
# ADMIN_TOKEN=


# ── Clerk (authentication) ───────────────────────────────────────────────────
# PROD REQUIRED. Both must be set together. Leave empty to disable auth in
# local dev — /api/auth/* then returns 503, and all role-protected routes
# return 503 until Clerk is configured.
#
# Read directly from process.env by both clerkMiddleware() and createClerkClient().
# Do not rename — the Clerk SDK looks these names up by convention.
#
# Get these from https://dashboard.clerk.com → your app → API keys.
#   - CLERK_SECRET_KEY must start with `sk_test_` or `sk_live_`
#   - CLERK_PUBLISHABLE_KEY must start with `pk_test_` or `pk_live_` and
#     must match VITE_CLERK_PUBLISHABLE_KEY in frontend/.env (same Clerk instance).
#
# CLERK_ENCRYPTION_KEY is NOT required for this app. It is only needed when
# using Clerk's handshake flow (SSR cookie sessions, OAuth callback handling
# on the backend). This backend only verifies Bearer tokens from the SPA, so
# the handshake path is never exercised.
#
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=


# ── Authorization: first-admin bootstrap ─────────────────────────────────────
# OPTIONAL. Comma-separated list of email addresses that should be promoted
# to role=ADMIN the *first time* they sign in. Matching is case-insensitive
# and only fires on fresh local-user creation — if the email already exists
# as a local User (role=USER by default), this list is ignored.
#
# Use this to bootstrap the very first admin on a clean database. To promote
# later users, change their role directly in the database (or via a one-off
# script). This env var is NOT consulted on every request.
#
# Example: INITIAL_ADMIN_EMAILS=alice@example.com,bob@example.com
# INITIAL_ADMIN_EMAILS=


# ── CORS + Clerk authorizedParties ───────────────────────────────────────────
# OPTIONAL in development (defaults to http://localhost:5173,http://localhost:3000).
# PROD REQUIRED. Must be set to the real frontend URL(s) in production.
# Comma-separated list of allowed origins, no trailing slashes.
#
# Used for two purposes:
#   1. CORS — Express only accepts cross-origin requests from these origins.
#   2. Clerk authorizedParties — Clerk rejects JWTs whose `azp` claim doesn't
#      match one of these origins, preventing cross-app token replay.
#
# Example: ALLOWED_ORIGINS=https://translate.example.com
# ALLOWED_ORIGINS=


# ── Reverse-proxy trust (TRUST_PROXY) ────────────────────────────────────────
# OPTIONAL. Controls whether Express honours X-Forwarded-For when computing
# req.ip. This is the ONLY signal the audit logger uses to record client IPs,
# so it must match your deployment topology.
#
# Accepted values:
#   unset / "false" / "0"  →  trust nothing (default — correct for local dev)
#   "1"                    →  trust exactly one reverse-proxy hop (Render, Railway,
#                             Fly, most PaaS fronted by their own load balancer)
#   "true"                 →  trust every hop (ONLY behind a network you control
#                             end-to-end; do not use on the open internet)
#   "2", "3", ...          →  that many trusted hops (e.g. Cloudflare → your LB → app)
#   "loopback" | CIDR | IP list → passed through to Express (see express docs)
#
# Guidance:
#   - local dev:        leave unset
#   - single Render / Railway / Fly service:   TRUST_PROXY=1
#   - Cloudflare in front of a Render service: TRUST_PROXY=2
#
# If set incorrectly, the audit log will record the proxy's IP (useless) or
# accept spoofed client IPs. Pick the value matching your actual hop count.
# TRUST_PROXY=


# ── Quality Gate ─────────────────────────────────────────────────────────────
# OPTIONAL. All have safe defaults. Tune these to adjust translation quality
# thresholds without changing code.

# Kill-switch for the entire quality gate pipeline. Default: true.
QG_ENABLED="true"

# OpenAI model used for the quality review LLM call. Default: gpt-4o-mini.
QG_REVIEW_MODEL="gpt-4o-mini"

# OpenAI model used for the repair LLM call. Default: gpt-4o-mini.
QG_REPAIR_MODEL="gpt-4o-mini"

# Minimum quality score (0.0–1.0) for a translation to pass without repair.
QG_MIN_PASSING_SCORE="0.75"

# Enable the automatic repair pass when quality score is below threshold.
QG_REPAIR_ENABLED="true"

# Enable fallback full-regeneration when repair still fails to reach threshold.
QG_REGENERATION_ENABLED="true"


# ── Compliance Bundles ────────────────────────────────────────────────────────
# OPTIONAL. Controls the published rule-bundle system.

# Kill-switch. Set to "false" to disable all bundle lookups and fall back to
# the legacy hardcoded jurisdiction rules. Default: true (bundles active).
# COMPLIANCE_BUNDLES_ENABLED=true

# In-memory bundle cache TTL in milliseconds. Default: 60000 (60 seconds).
# BUNDLE_CACHE_TTL_MS=60000


# ── Decision Layer (advanced tuning) ─────────────────────────────────────────
# OPTIONAL. These are rarely changed. The defaults are calibrated for
# financial-marketing compliance; change only with careful review.

# Weight of the semantic (primary) validator in the fused confidence score.
# Must sum to 1.0 with INDEPENDENT_WEIGHT. Default: 0.7.
# SEMANTIC_WEIGHT=0.7

# Weight of the independent (secondary) validator. Default: 0.3.
# INDEPENDENT_WEIGHT=0.3

# Confidence penalty (0–100) applied when validators disagree. Default: 10.
# DISAGREEMENT_PENALTY=10

# Fused confidence threshold below which risk is elevated to MEDIUM. Default: 70.
# LOW_RISK_THRESHOLD=70

# Fused confidence threshold above which risk is LOW for SAFE decisions. Default: 85.
# HIGH_RISK_THRESHOLD=85

# Fused confidence threshold below which decisions are escalated to human review.
# Default: 55.
# HUMAN_REVIEW_THRESHOLD=55


# ── Logging ───────────────────────────────────────────────────────────────────
# OPTIONAL. File path for uncertain-case audit log. Default: ./uncertain-cases.log
# In production, use an absolute path to a writable directory.
# UNCERTAIN_CASE_LOG_PATH=./uncertain-cases.log
